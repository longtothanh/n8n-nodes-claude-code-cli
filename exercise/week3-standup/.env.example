# ============================================================
# Week 3 — N8N Standup Bot secrets & config
# Copy this to `.env` next to docker-compose.yml; secrets are
# loaded by docker-compose.override.yml (env_file:) and read
# inside n8n via {{$env.VAR_NAME}} (N8N_BLOCK_ENV_ACCESS_IN_NODE=false).
# ============================================================

# --- GitHub ---
GITHUB_TOKEN=ghp_xxx_replace_me
GITHUB_OWNER=longtothanh
GITHUB_REPO=n8n-nodes-claude-code-cli

# --- Redmine ---
REDMINE_BASE_URL=https://dev.zigexn.vn
REDMINE_API_KEY=replace_me
# Optional nginx basic-auth gate. base64 of "user:pass":  printf "u:p" | base64
# Leave blank if your Redmine has no nginx basic-auth.
REDMINE_BASIC_B64=

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-replace-me
# Channel to READ messages from (C... channel ID)
SLACK_FETCH_CHANNEL_ID=C0XXXXXXXXX
# Channel/DM to POST standup to (U... DM ID, or C... channel ID)
SLACK_POST_CHANNEL_ID=C0XXXXXXXXX

# --- Claude Code session (memory persistence) ---
# Fixed UUID -> persists "last-N messages" context across runs via
# Claude Code CLI `--resume <session-id>` (Resume Session option).
STANDUP_SESSION_ID=7b3e9c2a-1d4f-4a6b-9c8e-2f0a5d7b1e30

# --- Harness fault-injection (red->green demo; leave blank normally) ---
STANDUP_FORCE_FAIL=

# --- N8N runtime ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
